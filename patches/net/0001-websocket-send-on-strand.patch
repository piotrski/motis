@@ -49,9 +49,16 @@ struct websocket_session : public ws_session {
     on_msg_ = std::move(fn);
   }
 
+  // Callable from any thread: the queue and the stream are only touched on
+  // the stream's executor (the session's strand).
   void send(std::string msg, ws_msg_type type, send_cb_t cb) override {
-    send_queue_.emplace(std::move(msg), type, cb);
